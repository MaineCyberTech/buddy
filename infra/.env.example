# Buddy App — Environment Variables
# Copy this to .env and fill in values

# Supabase (optional — app works offline without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Docker deployment
APP_DOMAIN=buddy.mainecybertech.us
API_DOMAIN=buddy-api.mainecybertech.us
TUNNEL_TOKEN=

# Cloudflare (for cloudflared tunnel mode)
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# DigitalOcean droplet IP (for SSH deploy)
DROPLET_IP=