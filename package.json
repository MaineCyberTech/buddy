{
  "name": "buddy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "audit": "npm audit --omit=dev",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0",
    "zod": "^3.23.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^1.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5"
  },
  "overrides": {
    "nanoid": "^3.3.19"
  }
}